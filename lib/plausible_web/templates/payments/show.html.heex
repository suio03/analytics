<.frame site={@site}>
  <a href={path(@site)} class="text-sm text-indigo-600 dark:text-indigo-400">
    ← All transactions
  </a>
  <div class="flex flex-wrap justify-between gap-4 mt-6 mb-8">
    <div>
      <div class="flex items-center flex-wrap gap-3">
        <h1 class="text-2xl font-semibold"><%= product_name(@transaction) %></h1>
        <.status_badge status={@transaction.status} />
      </div>
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
        Created <%= timestamp(@transaction.occurred_at, @site) %> · <%= provider_name(
          @transaction.integration.provider
        ) %> · <%= @transaction.integration.environment %>
      </p>
      <p class="mt-2 text-sm">
        <%= value(@transaction.customer_email) %><span class="ml-3 text-gray-500"><%= value(@transaction.country) %></span>
      </p>
    </div>
    <div class="text-right">
      <a
        href={dashboard_url(@transaction.integration, @transaction.external_id)}
        target="_blank"
        rel="noopener noreferrer"
        class="button"
      >
        <%= if @transaction.integration.provider == "creem",
          do: "Open Creem dashboard ↗",
          else: "View in Paddle ↗" %>
      </a>
      <p class="mt-3 font-mono text-xs text-gray-500 break-all select-all">
        <%= @transaction.external_id %>
      </p>
    </div>
  </div>

  <h2 class="font-semibold mb-5">Transaction details</h2>
  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8 text-sm">
    <div>
      <dt class="text-gray-500 mb-2">Type</dt>
      <dd><%= display_label(@transaction.kind) %></dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-2">Payment method</dt>
      <dd><%= method(@transaction) %></dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-2">Invoice / order</dt>
      <dd class="break-all select-all">
        <%= value(@transaction.details["invoice_number"] || @transaction.details["order_id"]) %>
      </dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-2">Provider status</dt>
      <dd><%= @transaction.provider_status %></dd>
    </div>
  </dl>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
    <div class="space-y-6">
      <section class="rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-6">
        <h2 class="text-sm text-gray-500">
          <%= if @transaction.status == "incomplete", do: "Amount due", else: "Amount paid" %>
        </h2>
        <p class="text-3xl font-semibold mt-3 tabular-nums">
          <%= money(
            if(@transaction.status == "incomplete",
              do: @transaction.amount,
              else: @transaction.paid_amount
            ),
            @transaction.currency
          ) %>
        </p>
        <div class="mt-6"><.status_badge status={@transaction.status} /></div>
        <p class="mt-3 text-xs text-gray-500">
          Paid: <%= timestamp(@transaction.paid_at, @site) %>
        </p>
      </section>
      <section class="rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-6">
        <h2 class="text-sm text-gray-500">Net earnings</h2>
        <p class="text-2xl font-semibold mt-3 tabular-nums">
          <%= money(@transaction.net, @transaction.currency) %>
        </p>
        <p class="mt-3 text-xs text-gray-500">
          <%= if is_nil(@transaction.net),
            do: "Not reported by provider",
            else: "After provider adjustments" %>
        </p>
      </section>
    </div>
    <section class="lg:col-span-2 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-6 sm:p-8">
      <h2 class="text-sm text-gray-500 mb-6">Payment breakdown · <%= @transaction.currency %></h2>
      <dl class="space-y-5 text-sm">
        <div class="flex justify-between">
          <dt>Transaction total</dt>
          <dd class="tabular-nums"><%= money(@transaction.amount, @transaction.currency) %></dd>
        </div>
        <div class="flex justify-between">
          <dt>Amount paid</dt>
          <dd class="tabular-nums">
            <%= money(@transaction.paid_amount, @transaction.currency) %>
          </dd>
        </div>
        <div class="flex justify-between border-t border-gray-200 dark:border-gray-700 pt-5">
          <dt>Tax included</dt>
          <dd class="tabular-nums"><%= money(@transaction.tax, @transaction.currency) %></dd>
        </div>
        <div class="flex justify-between">
          <dt>Provider fee</dt>
          <dd class="tabular-nums"><%= money(@transaction.fee, @transaction.currency) %></dd>
        </div>
        <div class="flex justify-between">
          <dt>Refunded</dt>
          <dd class="tabular-nums">
            <%= money(@transaction.refunded_amount, @transaction.currency) %>
          </dd>
        </div>
        <div class="flex justify-between font-semibold border-t border-gray-200 dark:border-gray-700 pt-5">
          <dt>Net earnings</dt>
          <dd class="tabular-nums"><%= money(@transaction.net, @transaction.currency) %></dd>
        </div>
      </dl>
      <p :if={@transaction.integration.provider == "creem"} class="text-xs text-gray-500 mt-6">
        Creem does not report fees, net earnings or payment method in this transaction API. Subscription purchases without first-payment evidence are shown as “Subscription”.
      </p>
    </section>
  </div>

  <h2 class="font-semibold mb-4">Product details</h2>
  <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700 mb-8">
    <div :for={item <- @transaction.items} class="flex justify-between gap-4 p-6">
      <div>
        <p class="font-medium">
          <%= item["name"] %><span :if={item["quantity"]} class="text-gray-500 font-normal"> · Quantity <%= item["quantity"] %></span>
        </p>
        <p class="text-xs text-gray-500 mt-2 break-all"><%= item["id"] %></p>
      </div>
      <div class="text-right text-sm tabular-nums">
        <%= money(item["unit_amount"], @transaction.currency) %>
        <p class="text-xs text-gray-500 mt-2">Unit price</p>
      </div>
    </div>
  </div>

  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm mb-10">
    <div>
      <dt class="text-gray-500 mb-1">Subscription ID</dt>
      <dd class="break-all select-all"><%= value(@transaction.subscription_id) %></dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-1">Customer ID</dt>
      <dd class="break-all select-all"><%= value(@transaction.customer_id) %></dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-1">Billing period starts</dt>
      <dd>
        <%= timestamp(
          Plausible.Payments.Normalize.datetime(
            get_in(@transaction.details, ["billing_period", "starts_at"])
          ),
          @site
        ) %>
      </dd>
    </div>
    <div>
      <dt class="text-gray-500 mb-1">Billing period ends</dt>
      <dd>
        <%= timestamp(
          Plausible.Payments.Normalize.datetime(
            get_in(@transaction.details, ["billing_period", "ends_at"])
          ),
          @site
        ) %>
      </dd>
    </div>
  </dl>

  <h2 class="font-semibold mb-4">Activity</h2>
  <ol class="border-l-2 border-gray-200 dark:border-gray-700 pl-5 space-y-5 text-sm">
    <li :for={event <- @events}>
      <p class="font-medium"><%= event.event_type %></p>
      <p class="text-gray-500 text-xs mt-1"><%= timestamp(event.occurred_at, @site) %></p>
    </li>
    <li>
      <p class="font-medium">Created</p>
      <p class="text-gray-500 text-xs mt-1"><%= timestamp(@transaction.occurred_at, @site) %></p>
    </li>
  </ol>
  <p class="text-xs text-gray-500 mt-5">
    Activity contains webhooks received after connection. Historical imports do not include past event notifications. Times shown in <%= @site.timezone %>.
  </p>
</.frame>
