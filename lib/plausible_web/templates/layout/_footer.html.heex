<div class="mt-24 bg-gray-800 dark:bg-gray-800">
  <div class="container px-4 py-12 sm:px-6 lg:py-16 lg:px-8">
    <div>
      <h4 class="font-semibold tracking-wider text-gray-300 leading-5">
        <%= img_tag(
          PlausibleWeb.Router.Helpers.static_path(
            @conn,
            logo_path("logo_dark.svg")
          ),
          class: "inline-block w-40 mr-1",
          alt: "Recount logo",
          loading: "lazy"
        ) %>
      </h4>
      <p class="mt-4 text-base text-gray-400 leading-6">
        <%= if ee?() do %>
          Made and hosted in the EU <span class="text-lg">🇪🇺</span> <br />
          Solely funded by our subscribers.
        <% end %>

        <%= if ce?() do %>
          Self-hosted analytics for the products we build.
        <% end %>
      </p>
      <%= if ce?() do %>
        <div class="mt-8">
          <h5 class="text-sm font-semibold tracking-wider text-gray-300 uppercase">
            Our products
          </h5>
          <div class="product-marquee mt-3">
            <ul class="product-marquee-track">
              <%= for copy <- [false, true, true, true] do %>
                <%= for {name, url, tagline} <- footer_products() do %>
                  <li aria-hidden={if copy, do: "true"}>
                    <a
                      href={url}
                      tabindex={if copy, do: "-1"}
                      target="_blank"
                      rel="noopener"
                      class="block rounded-md border border-gray-700 px-4 py-2 hover:border-gray-500"
                    >
                      <span class="block text-sm font-semibold text-gray-200"><%= name %></span>
                      <span class="block text-xs text-gray-400"><%= tagline %></span>
                    </a>
                  </li>
                <% end %>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
