<PlausibleWeb.Components.Generic.focus_box>
  <:title>
    Welcome to Recount!
  </:title>

  <p>
    Recount is the self-hosted analytics behind the products we build. Traffic, goals, revenue and session recordings for every site live in one privacy-friendly dashboard.
  </p>

  <:footer>
    <.focus_list>
      <:item>
        <.styled_link href={Routes.auth_path(@conn, :login)}>
          Login
        </.styled_link>
      </:item>
      <:item>
        <.styled_link href={Routes.auth_path(@conn, :register_form)}>
          Register
        </.styled_link>
      </:item>
    </.focus_list>
  </:footer>
</PlausibleWeb.Components.Generic.focus_box>
